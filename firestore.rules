rules_version = '2';

// AttendX production rules — replaces the expired test-mode rules.
// The Raspberry Pi uses the Admin SDK (service account) which BYPASSES
// these rules, so nothing here needs to allow the Pi.
// Deploy: Firebase Console -> Firestore Database -> Rules -> paste -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Role usually lives on the caller's own student doc ("hod"/"office" =
    // admin). Some admin/office accounts (e.g. the fixed admin@attendx.app
    // login) only ever get a `users/{uid}` doc created for them and have
    // NO matching `students/{uid}` doc — get() on a missing doc throws in
    // rules, which silently denies every admin write for that account. So
    // check `students` first and fall back to `users`.
    //
    // Compared case-insensitively: the app's own role checks (RoleRouter,
    // dashboard) lowercase the value before comparing, so a doc with
    // "Hod"/"HOD"/"Office" etc. still routes the user into admin screens
    // client-side — but a case-sensitive rule here would then reject
    // every single admin write with permission-denied. Matching the
    // client's leniency avoids that trap.
    // Admins and faculty have their own collections. `students` is
    // checked last and only as a fallback, because it's where the old
    // scheme piled everything and is the least trustworthy signal of
    // what an account actually is.
    function myRole() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ? get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'hod')
        : (exists(/databases/$(database)/documents/faculty_accounts/$(request.auth.uid))
            ? 'faculty'
            : (exists(/databases/$(database)/documents/students/$(request.auth.uid))
                ? get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role
                : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
                    : null)));
    }

    function isAdmin() {
      return signedIn() && myRole() is string && myRole().lower() in ['hod', 'office'];
    }

    function isCr() {
      return signedIn() && myRole() is string && myRole().lower() == 'cr';
    }

    function isFaculty() {
      return signedIn() && myRole() is string && myRole().lower() == 'faculty';
    }

    // The caller's own study year, straight from their student doc.
    // Used to pin a CR to their own year — they can't file attendance
    // for a class they aren't in.
    function myYear() {
      return exists(/databases/$(database)/documents/students/$(request.auth.uid))
        ? get(/databases/$(database)/documents/students/$(request.auth.uid)).data.get('year', 0)
        : 0;
    }

    // ---------- clock helpers ----------
    // request.time is UTC; the college runs on IST. Comparing a UTC
    // date against a date string the phone wrote in IST would reject
    // every mark made before 05:30 and accept the wrong day after
    // 18:30, so the offset is applied before anything is compared.
    function istNow() {
      return request.time + duration.value(330, 'm');
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function istDateId() {
      return string(istNow().year) + '-' + pad2(istNow().month)
        + '-' + pad2(istNow().day);
    }

    function istDayName() {
      return ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday',
              'Saturday', 'Sunday'][istNow().dayOfWeek() - 1];
    }

    // Faculty sign-ups land as 'pending' and can't mark anything until an
    // admin approves them and links them to a timetable record. Enforced
    // here, not just in the UI, so an unapproved account can't write to
    // period_attendance directly.
    function isApprovedFaculty() {
      return isFaculty()
        && (
          (exists(/databases/$(database)/documents/faculty_accounts/$(request.auth.uid))
            && get(/databases/$(database)/documents/faculty_accounts/$(request.auth.uid)).data.get('facultyStatus', 'pending') == 'approved')
          // Accounts not yet migrated out of `students`.
          || (exists(/databases/$(database)/documents/students/$(request.auth.uid))
            && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.get('facultyStatus', 'pending') == 'approved')
        );
    }

    // ---------- admins ----------
    // Readable by any signed-in user, because the role check above has
    // to be able to see it. Not writable from the app at all: an admin
    // is created in the Firebase console, deliberately, by someone with
    // project access. A self-service path to `role: hod` would be the
    // single worst hole in this ruleset.
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- faculty accounts ----------
    // A faculty member creates their own record at sign-up and may edit
    // their own details. `facultyStatus` and `facultyId` are admin-only
    // on both create and update — otherwise approving yourself would be
    // a matter of picking the right value at sign-up.
    match /faculty_accounts/{uid} {
      allow read: if signedIn();

      allow create: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.get('facultyStatus', 'pending') == 'pending'
            && request.resource.data.get('facultyId', '') == '');

      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.get('facultyStatus', 'pending')
                 == resource.data.get('facultyStatus', 'pending')
            && request.resource.data.get('facultyId', '')
                 == resource.data.get('facultyId', ''));

      allow delete: if isAdmin();
    }

    // ---------- students ----------
    // Signed-in users can read profiles (needed for timetable/CR/admin
    // screens); users create/update only their own doc; admins manage all.
    match /students/{uid} {
      allow read: if signedIn();

      // Registration. `role` is restricted so nobody can sign up as an
      // admin, and a faculty sign-up must start out pending — otherwise
      // approving yourself would just be a matter of picking the right
      // value at create time.
      allow create: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.get('role', 'student') in ['student', 'faculty']
            && request.resource.data.get('facultyStatus', 'pending') == 'pending'
            && request.resource.data.get('facultyId', '') == '');

      // Self-service edits (profile, face enrollment flags, CR requests)
      // are fine, but the three fields that grant power are admin-only:
      // `role` decides which app you get, and facultyStatus/facultyId
      // together decide whose attendance you can mark.
      allow update: if isAdmin()
        || (isSelf(uid)
            && request.resource.data.get('role', 'student')
                 == resource.data.get('role', 'student')
            && request.resource.data.get('facultyStatus', 'pending')
                 == resource.data.get('facultyStatus', 'pending')
            && request.resource.data.get('facultyId', '')
                 == resource.data.get('facultyId', ''));

      // Self-delete needed for the in-app "Delete Account" flow.
      allow delete: if isSelf(uid) || isAdmin();
    }

    // ---------- face templates ----------
    // Readable by signed-in clients (face verification); written by the
    // owner (enrollment + adaptive learning) or admins.
    match /student_face_enrollments/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid) || isAdmin();
    }

    // ---------- attendance events (written ONLY by the Pi's Admin SDK) ----------
    // Students read their own; admins read all. Creates/edits are NEVER
    // allowed from a client (only the Pi's Admin SDK, which bypasses
    // these rules) — that keeps attendance history tamper-proof day to
    // day. Delete is the one exception, scoped to a student erasing
    // their OWN events, and exists solely to support the in-app "Delete
    // Account" flow (which also deletes the student's profile/face data
    // in the same action) — not a way to selectively edit attendance.
    match /attendance_events/{eventId} {
      // resource == null: reading a not-yet-created day doc (e.g. today's
      // attendance before first check-in) must return empty, not error.
      allow read: if signedIn()
                  && (resource == null
                      || resource.data.uid == request.auth.uid
                      || isAdmin());
      allow create, update: if false;
      allow delete: if signedIn()
                    && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ---------- manual attendance corrections ----------
    // The layer that lets a human fix what the scanner got wrong, without
    // ever touching the Pi's own record above. Anyone signed in can read
    // (a student needs to see their own corrected days, and the merge
    // happens client-side), but writing is limited to admins and to CRs
    // holding an approved grant for that day's month — checked here, not
    // just in the UI, so a CR can't write straight to the collection
    // after their month lapses.
    //
    // Each doc carries its own `month` (yyyy-MM) field, which is exactly
    // the key its permission doc is filed under.
    function crMayMark(month) {
      return isCr()
        && exists(/databases/$(database)/documents/cr_attendance_permissions/$(request.auth.uid + '_' + month))
        && get(/databases/$(database)/documents/cr_attendance_permissions/$(request.auth.uid + '_' + month)).data.status == 'approved';
    }

    match /attendance_manual/{id} {
      allow read: if signedIn();

      // The month must agree with the date it claims to cover, otherwise
      // a CR approved for one month could file marks against another.
      allow create, update: if isAdmin()
        || (request.resource.data.markedBy == request.auth.uid
            && request.resource.data.month == request.resource.data.date[0:7]
            && crMayMark(request.resource.data.month));

      // Students may clear their own, which is what the in-app "Delete
      // Account" flow needs — same exception attendance_events makes,
      // and for the same reason.
      allow delete: if isAdmin()
        || crMayMark(resource.data.month)
        || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---------- CR attendance-marking permissions ----------
    // A CR raises their own pending request and can read the queue; only
    // an admin decides. The status guard on create/update is what stops a
    // CR from writing themselves an 'approved' doc and unlocking the
    // rules above on their own.
    match /cr_attendance_permissions/{id} {
      allow read: if signedIn();

      allow create: if isAdmin()
        || (isCr()
            && request.resource.data.crUid == request.auth.uid
            && request.resource.data.status == 'pending');

      allow update: if isAdmin()
        || (isCr()
            && resource.data.crUid == request.auth.uid
            && request.resource.data.status == 'pending');

      allow delete: if isAdmin();
    }

    // ---------- per-period class attendance ----------
    // Written by the faculty member teaching the period (after they
    // confirm the camera's draft) and by admins. Readable by anyone
    // signed in, because a student has to be able to see their own
    // subject-wise record — and Firestore can't filter an array on read,
    // so the document is fetched whole and filtered client-side.
    //
    // `markedBy` is pinned to the caller on write, so a faculty member
    // can't file a period under someone else's name. Deletes are
    // admin-only: a wrong period should be corrected by re-marking it
    // (which overwrites, and leaves an audit trail), never by making the
    // record disappear.
    //
    // A CR may write labs, and only labs, and only for their own year,
    // and only on the day itself.
    //
    // The "it's a lab" claim is not taken from the document being
    // written — a CR could simply set that field on a theory period and
    // mark themselves present in every lecture. It's read back from the
    // timetable, at the slot for today's weekday, which is the same
    // record the student calendar counts against. Same reason the
    // weekday comes from the server clock rather than the payload:
    // otherwise a CR could point a Monday theory period at Friday's lab
    // slot and have it validate.
    //
    // Residual: `academicYear` is taken from the payload, so a CR could
    // in principle cite a past year whose timetable had a lab in that
    // slot. It would still be visible as a lab marked by a named CR, and
    // an admin can delete it.
    function crMayMarkLab() {
      return isCr()
        && request.resource.data.markedBy == request.auth.uid
        // Compared as strings: some student docs carry `year` as an int,
        // older ones as a string, and a type mismatch here would lock a
        // legitimate CR out with no visible reason.
        && string(request.resource.data.year) == string(myYear())
        && request.resource.data.date == istDateId()
        && get(/databases/$(database)/documents/timetables/$(request.resource.data.department)/$(request.resource.data.academicYear)/$(string(request.resource.data.year))/$(istDayName())/$(string(request.resource.data.periodNo)))
             .data.get('classType', '').lower() == 'lab';
    }

    // Labs are the case where the camera is worst placed — students
    // face benches, not the front — and the CR is best placed. Theory
    // stays out of their hands entirely: it's captured by the lecturer's
    // scan, and letting a student edit it would put the register in the
    // hands of the people it judges. No approval gate here, unlike the
    // day-level manual marks, because the lab roster is narrow enough
    // (own year, own lab slot, today only) to be self-limiting.
    match /period_attendance/{id} {
      allow read: if signedIn();

      allow create, update: if isAdmin()
        || (isApprovedFaculty()
            && request.resource.data.markedBy == request.auth.uid)
        || crMayMarkLab();

      allow delete: if isAdmin();
    }

    // ---------- notifications ----------
    // Users read/update/delete their own; any signed-in user may create
    // (app generates arrival/schedule notifications client-side).
    match /notifications/{id} {
      allow read, update, delete: if signedIn()
                  && (resource.data.studentUid == request.auth.uid || isAdmin());
      allow create: if signedIn();
    }

    // ---------- timetables (nested: dept/year/weekday) ----------
    match /timetables/{path=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /timetable_overrides/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || isCr();
    }

    // ---------- reference data managed by admins ----------
    // Every signed-in user reads holidays — attendance can't be computed
    // without knowing which days were closed, and that runs on every
    // student's own device.
    match /holidays/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }

    match /batch_config/{id} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /users/{uid}     { allow read: if isSelf(uid) || isAdmin(); allow write: if isAdmin(); }
    match /subjects/{id}   { allow read: if signedIn(); allow write: if isAdmin(); }
    // Readable without signing in: the faculty registration form offers
    // a "find your name" dropdown, and that screen is reached before an
    // account exists. The contents — staff names, initials, designations
    // and employee IDs — are already printed on every timetable, so
    // there is nothing here a signed-out reader couldn't see on a
    // noticeboard. Writes stay admin-only.
    match /faculty/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /rooms/{id}      { allow read: if signedIn(); allow write: if isAdmin(); }
    match /labs/{id}       { allow read: if signedIn(); allow write: if isAdmin(); }
    match /time_slots/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // ---------- app self-update metadata ----------
    // Read before/without login so the update prompt always works.
    match /app_meta/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
